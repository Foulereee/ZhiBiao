BMP_DEBUG=true
BMP_HOST=0.0.0.0
BMP_PORT=8000

BMP_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bidmaster
BMP_REDIS_URL=redis://localhost:6379/0
BMP_CHROMA_DIR=./chroma_db
BMP_PROJECTS_ROOT=./projects

BMP_LLM_DEFAULT_MODEL=deepseek/deepseek-chat
BMP_LLM_API_KEY=
BMP_LLM_API_BASE=https://api.deepseek.com
BMP_LLM_FALLBACK_MODES=ollama/qwen2.5
BMP_LLM_MAX_RETRIES=3

BMP_EMBEDDING_MODE=api
BMP_EMBEDDING_MODEL=text-embedding-v3
BMP_EMBEDDING_API_KEY=
BMP_EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

BMP_MINERU_MODE=cloud
BMP_MINERU_API_KEY=
BMP_MINERU_ENDPOINT=https://mineru.net/api/v4
BMP_MINERU_TIMEOUT=180
BMP_MINERU_MODEL_VERSION=vlm
BMP_MINERU_POLL_INTERVAL=5
BMP_MINERU_MAX_POLLS=60

# 招标/投标文本最大字符数（截断 LLM 入参以避免超长上下文）
BMP_TENDER_TEXT_MAX_CHARS=32000
