# ============================================================================
# BidMaster Pro - Docker 部署环境变量
#
# 两种部署模式：
#   A) 全量部署（compose 内置基础设施）：
#      docker compose --profile infra up -d
#   B) 仅API（外部依赖已就绪）：
#      docker compose up -d
#
# 使用方法：
#   cp docker/.env.docker.example docker/.env.docker
#   编辑填写真实密钥后启动
# ============================================================================

# ─────────────── 应用模式 ───────────────
# 调试模式（生产请保持 false）
BMP_DEBUG=false
# Uvicorn worker 进程数（按 CPU 核数调整，一般 2~4）
UVICORN_WORKERS=2

# ─────────────── 数据库类型（二选一）───────────────
# postgresql（默认）/ mysql
BMP_DB_TYPE=postgresql

# ─────────────── PostgreSQL（BMP_DB_TYPE=postgresql 时使用）───────────────
# compose 内置 PG 时（--profile infra）使用下方默认值
# 外部 PG 时，设置 BMP_DATABASE_URL 覆盖（见下方「外部依赖」段）
POSTGRES_DB=bidmaster
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres          # 生产环境务必修改为强密码
POSTGRES_PORT=5432

# ─────────────── MySQL（BMP_DB_TYPE=mysql 时使用）───────────────
# compose 内置 MySQL 时需同时启用 --profile infra --profile mysql
MYSQL_PASSWORD=root                 # 生产环境务必修改为强密码
MYSQL_USER=bidmaster
MYSQL_APP_PASSWORD=bidmaster123     # 生产环境务必修改
MYSQL_DATABASE=bidmaster
MYSQL_PORT=3306

# ─────────────── Redis ───────────────
# compose 内置 Redis（--profile infra）时：REDIS_HOST 留空，REDIS_INTERNAL_PORT 留空
# 外部 Redis 时：REDIS_HOST 设为外部 IP/域名，REDIS_INTERNAL_PORT 设为外部 Redis 端口
REDIS_HOST=
REDIS_INTERNAL_PORT=6379
# 宿主机端口映射（仅 --profile infra 时生效，外部 Redis 不需要）
REDIS_EXTERNAL_PORT=16379

# ─────────────── MinIO 对象存储 ───────────────
# compose 内置 MinIO（--profile infra）时：MINIO_ENDPOINT 留空
# 外部 MinIO 时：MINIO_ENDPOINT 设为 host:port（如 192.168.1.100:9000）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin      # 生产环境务必修改为强密码
MINIO_BUCKET=bidmaster
MINIO_ENDPOINT=
# 宿主机端口映射（仅 --profile infra 时生效）
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# ─────────────── 外部依赖覆盖（仅外部依赖模式需要）───────────────
# 以下变量留空则使用上方 compose 内置默认值，填写则覆盖为外部地址

# 外部 PostgreSQL 连接串（覆盖 compose 内 postgres:5432）
# BMP_DATABASE_URL=postgresql+asyncpg://user:pass@192.168.1.100:5432/bidmaster

# 外部 MySQL 地址（覆盖 compose 内 mysql:3306）
# BMP_MYSQL_HOST=192.168.1.100
# BMP_MYSQL_PORT=3306

# ─────────────── LLM 大模型（必填）───────────────
LLM_MODEL=deepseek/deepseek-chat
LLM_API_KEY=sk-your-deepseek-api-key
LLM_API_BASE=https://api.deepseek.com
LLM_FALLBACK_MODES=ollama/qwen2.5

# ─────────────── Embedding 向量模型（知识库用）───────────────
EMBEDDING_MODE=api
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=sk-your-dashscope-api-key
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ─────────────── MinerU OCR（招标文件解析，可选）───────────────
MINERU_MODE=cloud
MINERU_API_KEY=
MINERU_ENDPOINT=https://mineru.net/api/v4

# ─────────────── 端口映射 ───────────────
API_PORT=8000
WEB_PORT=8080

# ─────────────── CORS 允许来源（逗号分隔，可选）───────────────
# 桌面客户端默认已放行 app://. 与 localhost:15168/15169
# ALLOWED_ORIGINS=https://bidmaster.example.com,http://192.168.1.100:8080
ALLOWED_ORIGINS=

# ─────────────── Celery 并发数 ───────────────
CELERY_CONCURRENCY=2
