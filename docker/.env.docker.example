# ============================================================================
# BidMaster Pro - Docker 部署环境变量
# 使用方法：
#   cp docker/.env.docker.example docker/.env.docker
#   编辑填写真实密钥后：
#   docker compose --env-file docker/.env.docker up -d
# ============================================================================

# ─────────────── 应用模式 ───────────────
# 调试模式（生产请保持 false）
BMP_DEBUG=false
# Uvicorn worker 进程数（按 CPU 核数调整，一般 2~4）
UVICORN_WORKERS=2

# ─────────────── 数据库类型（二选一）───────────────
# postgresql（默认）/ mysql
# 选择 mysql 时需启用 --profile mysql 启动（见 DEPLOY.md「使用 MySQL」）
BMP_DB_TYPE=postgresql

# ─────────────── PostgreSQL（BMP_DB_TYPE=postgresql 时使用）───────────────
POSTGRES_DB=bidmaster
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres          # 生产环境务必修改为强密码
POSTGRES_PORT=5432

# ─────────────── MySQL（BMP_DB_TYPE=mysql 时使用，需 --profile mysql）───────────────
# MySQL root 密码（同时用于 healthcheck）
MYSQL_PASSWORD=root                 # 生产环境务必修改为强密码
# 应用账号（mysql 镜像自动创建，非 root，权限限于业务库）
MYSQL_USER=bidmaster
MYSQL_APP_PASSWORD=bidmaster123     # 生产环境务必修改
MYSQL_DATABASE=bidmaster
MYSQL_PORT=3306
# 若 MySQL 部署在外部（非 compose 内 mysql 服务），可覆盖主机地址
# BMP_MYSQL_HOST=192.168.1.100

# ─────────────── Redis ───────────────
REDIS_PORT=16379

# ─────────────── MinIO 对象存储 ───────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin      # 生产环境务必修改为强密码
MINIO_BUCKET=bidmaster
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# ─────────────── LLM 大模型（必填）───────────────
# DeepSeek 示例；也可换 OpenAI / 通义千问 / Ollama 等（litellm 格式）
LLM_MODEL=deepseek/deepseek-chat
LLM_API_KEY=sk-your-deepseek-api-key
LLM_API_BASE=https://api.deepseek.com
LLM_FALLBACK_MODES=ollama/qwen2.5

# ─────────────── Embedding 向量模型（知识库用）───────────────
EMBEDDING_MODE=api
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=sk-your-dashscope-api-key
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ─────────────── MinerU OCR（招标文件解析，可选）───────────────
MINERU_MODE=cloud
MINERU_API_KEY=
MINERU_ENDPOINT=https://mineru.net/api/v4

# ─────────────── 端口映射 ───────────────
# API 服务对外端口（桌面客户端连接此地址）
API_PORT=8000
# Web 版端口（仅 --profile web 启动时生效）
WEB_PORT=8080

# ─────────────── CORS 允许来源（逗号分隔，可选）───────────────
# 桌面客户端默认已放行 app://. 与 localhost:15168/15169
# 如需额外来源（如浏览器访问域名），在此追加：
# ALLOWED_ORIGINS=https://bidmaster.example.com,http://192.168.1.100:8080
ALLOWED_ORIGINS=

# ─────────────── Celery 并发数 ───────────────
CELERY_CONCURRENCY=2

